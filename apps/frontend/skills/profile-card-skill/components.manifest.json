{
  "version": "1.0",
  "components": [
    {
      "name": "ProfileIntroCard",
      "type": "ProfileIntroCard",
      "description": "人物介绍卡片，适合展示基础信息、标签与分组资料。",
      "propsSchema": {
        "name": "string，必填，人物名",
        "title": "string，可选，主标题或身份",
        "subtitle": "string，可选，补充说明",
        "summary": "string，可选，摘要简介",
        "avatar": "string，可选，emoji 或短文本头像",
        "coverImage": "string，可选，背景图 URL",
        "tags": "string[]，可选，标签列表",
        "sections": [
          {
            "title": "string，分组标题",
            "items": [
              {
                "label": "string，字段名",
                "value": "string，字段值"
              }
            ]
          }
        ]
      },
      "example": {
        "type": "ProfileIntroCard",
        "props": {
          "name": "示例人物",
          "title": "示例身份",
          "subtitle": "一句辅助说明",
          "avatar": "👤",
          "tags": ["标签A", "标签B"],
          "sections": [
            {
              "title": "基本信息",
              "items": [
                { "label": "出生地", "value": "示例城市" },
                { "label": "职业", "value": "示例职业" }
              ]
            }
          ]
        }
      }
    }
  ]
}
