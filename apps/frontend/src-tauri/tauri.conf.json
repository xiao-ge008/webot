{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WeBot",
  "version": "1.0.6",
  "identifier": "ai.webot.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WeBot",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "dmg", "app"],
    "windows": {
      "wix": {
        "upgradeCode": "A6A3B3C2-7C42-4F8A-9C2D-6C6F2E7B2A11"
      }
    },
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "resources": [
      "resources/mpv",
      "resources/openfang",
      "resources/skills",
      "../../../comfyui"
    ]
  }
}
